{
  "name": "alhaj-cut-studio",
  "private": true,
  "version": "2.0.0",
  "description": "AlHaj Cut Studio — Static Browser-Based AI Background Remover & Multi-Layer Photo Studio",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "node scripts/build-static.mjs",
    "preview": "vite preview --port=4173 --host=127.0.0.1",
    "clean": "node -e \"const fs=require('fs'); for(const d of ['dist','AlHaj-Cut-Studio-Static']) fs.rmSync(d,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/utils/studioMath.test.ts"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/cairo": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/readex-pro": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@gradio/client": "2.8.0",
    "@huggingface/transformers": "3.8.1",
    "@imgly/background-removal": "1.7.0",
    "jszip": "3.10.2",
    "lucide-react": "0.546.0",
    "onnxruntime-web": "1.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
